  "cards": [
    {
      "dot": "cyan",
      "title": "运行形态",
      "items": [
        "生产：Nginx 托管静态文件，并将 /api 同源代理到 Flask :5099",
        "开发：Vite 可代理 /api；VITE_API_MODE=mock 时请求停留在浏览器内"
      ]
    },
    {
      "dot": "emerald",
      "title": "模块化单体",
      "items": [
        "公共与业务蓝图按 capability 注册，但仍运行在单个 Flask 应用中",
        "领域服务集中处理输入校验、事务、查询与操作审计"
      ]
    },
    {
      "dot": "rose",
      "title": "安全与信任",
      "items": [
        "远程模式通过携带凭据的 fetch 使用签名 Session Cookie",
        "写接口由 admin / maintainer 门禁保护；生产 Cookie 使用 Secure、HttpOnly、SameSite=Lax"
      ]
    },
    {
      "dot": "amber",
      "title": "数据与外部依赖",
      "items": [
        "私有版 profile 可选 PostgreSQL、GaussDB/DWS；Community 允许 SQLite 与 PostgreSQL",
        "Lineage Viewer 1.1.0 在客户端渲染；门户维护元数据，不执行真实采集、调度或文件推送"
      ]
    }
  ]
