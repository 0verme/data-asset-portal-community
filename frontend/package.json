{
  "name": "data-asset-portal",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "workspaces": [
    "packages/lineage-viewer",
    "packages/lineage-viewer-react",
    "packages/lineage-viewer-domain-adapter"
  ],
  "scripts": {
    "dev": "vite",
    "dev:log": "powershell -ExecutionPolicy Bypass -File ./scripts/dev-frontend.ps1",
    "dev:backend": "powershell -ExecutionPolicy Bypass -File ../backend/scripts/dev-backend.ps1",
    "dev:backend:sh": "bash ../backend/scripts/dev-backend.sh",
    "build": "npm run build:lineage && npm run build:frontend",
    "build:lineage": "npm run build --workspace=lineage-viewer && npm run build --workspace=@lineage-viewer/domain-adapter && npm run build --workspace=@lineage-viewer/react",
    "build:frontend": "vite build",
    "test:browser": "playwright test --config playwright.config.ts",
    "test:browser:install": "playwright install chromium webkit",
    "typecheck:app": "tsc -p tsconfig.app.json --noEmit",
    "typecheck:lineage": "npm run typecheck --workspace=lineage-viewer && npm run typecheck --workspace=@lineage-viewer/domain-adapter && npm run typecheck --workspace=@lineage-viewer/react",
    "typecheck": "npm run typecheck:app && npm run typecheck:lineage",
    "verify:lineage-packages": "node scripts/verify-lineage-packages.mjs",
    "test": "node --experimental-strip-types --test \"src/**/*.test.ts\"",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\" \"scripts/**/*.{js,mjs}\" --max-warnings 0",
    "preview": "vite preview",
    "export:assets": "node scripts/export-assets.mjs"
  },
  "dependencies": {
    "@cloudflare/kumo": "2.14.0",
    "@lineage-viewer/domain-adapter": "1.1.0",
    "@lineage-viewer/react": "1.1.0",
    "@phosphor-icons/react": "2.1.10",
    "lineage-viewer": "1.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
