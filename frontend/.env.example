VITE_API_MODE=remote
# Build-time default accent preset, used when no valid local preference exists.
VITE_DEFAULT_ACCENT=purple
# Optional stable identifier for separate deployments sharing an origin and Vite base.
# VITE_APPEARANCE_SCOPE=community
# remote: 前端调用 /api，使用后端真实数据 + 真实登录（正式部署与 Community Demo 完整演示均使用 remote）
# mock: 前端使用内置 mock 数据 + 演示登录(admin / 123456)——仅前端开发/零依赖体验，数据不落库
# 注意：该开关同时决定数据与认证，二者绑定。mock 模式固定使用演示账号 admin / 123456，且绝不影响 remote/backend auth。
# 可选覆盖
# VITE_API_BASE_URL=/api
# Ordinary API timeout override in ms; long requests have a 120s minimum,
# while AI Ask has a 125s minimum for its default queue/worker deadline.
# Raise this value if AI_ASK_WORKER_TIMEOUT_SECONDS is explicitly increased.
# VITE_API_TIMEOUT=60000
# 后端固定运行在 15099 端口
# VITE_BACKEND_URL=http://127.0.0.1:15099
