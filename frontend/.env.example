VITE_API_MODE=mock
# mock: 前端使用内置 mock 数据 + 演示登录(admin/admin123)——仅前端开发/零依赖体验，数据不落库
# remote: 前端调用 /api，使用后端真实数据 + 真实登录（Community Demo 完整演示请使用 remote）
# 注意：该开关同时决定数据与认证，二者绑定。
# 演示登录账号（仅 mock 模式生效）
# VITE_MOCK_AUTH_USER=admin
# VITE_MOCK_AUTH_PASSWORD=admin123
# VITE_MOCK_AUTH_NAME=管理员
# 可选覆盖
# VITE_API_BASE_URL=/api
# VITE_API_TIMEOUT=60000
# 后端固定运行在 5099 端口
# VITE_BACKEND_URL=http://127.0.0.1:5099
