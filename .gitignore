# 依赖
node_modules

# 构建产物
frontend/dist

# Lineage workspace outputs are rebuilt from src before app builds and package releases.
frontend/packages/lineage-viewer/dist/
frontend/packages/lineage-viewer-react/dist/
frontend/packages/lineage-viewer-domain-adapter/dist/
*.tgz

# 缓存
.vite
backend/.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# 日志与临时文件
*.log
*.tmp
*.bak
*.old
*.backup
*.out.txt
*.err.txt
logs/*
!logs/.gitkeep

# 环境变量：仅提交 .env.example，本地配置不入库
.env
.env.local
*.local

# 数据库实连配置：仅提交 database.example.yaml 模板
backend/configs/database.yaml
backend/configs/database.local*.yaml

# One-command Community Demo runtime (SQLite, generated config and secret)
.demo/

# 本地数据库文件产物（Community Demo / CI 使用 SQLite；防止误提交）
*.db
*.sqlite
*.sqlite3

# 临时输出
tmp/

# 第三方商业 JDBC 驱动：自行从官方渠道获取，经 ASSET_DB_JAR_PATH 注入
backend/resources/jars/*.jar
!backend/resources/jars/README.md

# demo SQL 生成器可选输出目录（默认已写 tmp/demo-sql/）
demo/generated/

# 操作系统文件
.DS_Store
Thumbs.db
