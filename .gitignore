# 依赖
node_modules

# 构建产物 / 打包文件
frontend/dist
frontend/dist-check
frontend/portal-dist.tar.gz

# 缓存
.vite
frontend/.vite
backend/.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# 日志与临时文件
*.log
*.tmp
*.bak
*.old
*.backup
*.out.txt
*.err.txt
logs/*
!logs/.gitkeep

# 环境变量：仅提交 .env.example，本地配置不入库
.env
.env.local
backend/.env
backend/.env.local
frontend/.env.local
*.local

# 数据库实连配置：仅提交 database.example.yaml 模板
backend/configs/database.yaml
backend/configs/database.local*.yaml

# 本地数据库文件产物（项目不再支持 SQLite；防止误提交）
backend/data/
*.db
*.sqlite
*.sqlite3

# 工具临时输出
.codex/
.claude/
outputs/
tmp/

# 导出工具输出（测试库内容默认写 git-ignored 目录，写仓库需显式 --allow-repository-output）
tmp/sync-from-pg/
tmp/db-init-sql/
tmp/demo-sql/

# 第三方商业 JDBC 驱动：自行从官方渠道获取，经 ASSET_DB_JAR_PATH 注入
backend/resources/jars/*.jar
!backend/resources/jars/README.md

# demo SQL 生成器可选输出目录（默认已写 tmp/demo-sql/）
demo/generated/

# 宣传片素材（体积大，默认不入库）
videos/

# 操作系统文件
.DS_Store
Thumbs.db
