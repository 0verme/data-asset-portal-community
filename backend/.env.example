# 首次部署模板：只填写 Core 配置。Advanced/Test 配置见 docs/configuration.md。

# Application
# APP_ENV controls HTTP/runtime behavior, not database selection.
# If unset or blank, APP_ENV defaults to production. Only normalized "development"
# enables /docs, /redoc and /openapi.json HTTP endpoints.
#
# development:
#   - Does not set the Secure flag on session cookies, supporting localhost/
#     plain-HTTP login and smoke testing during development.
# production:
#   - Disables the interactive OpenAPI HTTP endpoints above.
#   - Sets the session cookie Secure flag for HTTPS. Use HTTPS to verify
#     production login/session behavior; localhost HTTP handling varies by browser.
#   - Rejects startup when APP_DEBUG=true.
#
# Database profiles are selected separately by ASSET_DB_PROFILE and
# ASSET_AUTH_DB_PROFILE; changing APP_ENV does not choose the database.
# Set APP_ENV=development for local HTTP development; keep production for HTTPS.
APP_ENV=production
APP_SECRET_KEY=<generate-a-strong-random-value>
# Keep false in production; production startup rejects debug mode.
APP_DEBUG=false
# Finite global ASGI body cap; lineage metadata also has a stricter 96 MiB cap.
APP_MAX_CONTENT_LENGTH_MB=128
# Optional lineage snapshot deployment overrides (finite hard ceilings apply).
METADATA_MAX_BODY_MB=96
METADATA_MAX_LINEAGE_NODES=30000
METADATA_MAX_LINEAGE_EDGES=75000
# APP_CORS_ORIGINS=https://portal.example.com
APP_LOG_LEVEL=INFO

# Database profile and config
# Copy backend/configs/database.example.yaml → backend/configs/database.yaml (not committed).
# Leave ASSET_DB_CONFIG_PATH unset to use that default path (resolved from the backend package,
# independent of process cwd). Set an absolute path only for environment-specific YAML.
# Select one profile defined in backend/configs/database.yaml.
# Examples: primary / mysql_primary / gauss_primary
ASSET_DB_PROFILE=primary
# Usually authentication uses the same database profile.
# ASSET_AUTH_DB_PROFILE=primary
# ASSET_DB_CONFIG_PATH=/absolute/path/to/database.yaml
# Optional non-empty overrides; secrets should come from a secret manager.
# ASSET_DB_PASSWORD=
# ASSET_DB_DSN=

# Deployment/security policy
ASSET_TRUST_PROXY_HEADERS=false
AUTH_SESSION_DAYS=14

# internal: 内网默认，允许业务联系人、host/port/database/schema 等安全连接定位元数据，并允许按这些字段搜索
# strict: 隐藏人员身份与连接定位元数据，且隐藏字段不参与匿名搜索
# disabled: 禁止匿名业务目录与匿名搜索
# 任意 profile 都永久隐藏账号、密码、token、secret、credential 等凭据；可展示字段与可搜索字段共用同一策略。
PUBLIC_CATALOG_PROFILE=internal

# 是否允许匿名批量导出公开目录数据
PUBLIC_CATALOG_EXPORT_ENABLED=false

# APP_* is the only supported application configuration namespace. Historical
# names are ignored; see docs/configuration.md for the migration table.
