# 后端始终连接数据库：认证与数据统一使用 configs/database.yaml 中的 profile，无运行模式开关。
# 支持数据库类型：sqlite（Community 本地演示/开发/CI）、postgres（PostgreSQL，Community 与完整版）、
# gaussdb（GaussDB / DWS，仅完整版 Private 模块，需可选 JDBC 驱动）。
# 生产推荐 PostgreSQL 或 GaussDB/DWS；SQLite 不是生产目标。
# 配置缺失或类型非法时必须启动失败，不会回退到本地文件库。

# Database profiles
# ASSET_DB_PROFILE=primary
# ASSET_AUTH_DB_PROFILE=primary
# ASSET_DB_CONFIG_PATH=<project-root>/backend/configs/database.yaml
# ASSET_DB_JAR_PATH=/opt/data-asset-portal/backend/resources/jars/gaussdb200.jar
# ASSET_DB_CONNECT_TIMEOUT_SECONDS=30
# ASSET_DB_STATEMENT_TIMEOUT_MS=120000
# Sensitive profile overrides. Environment values take precedence over database.yaml.
# ASSET_DB_HOST=127.0.0.1
# ASSET_DB_PORT=5432
# ASSET_DB_DATABASE=asset_portal
# ASSET_DB_USER=change_me
# ASSET_DB_PASSWORD=<store-in-secret-manager>
# ASSET_DB_DSN=<store-in-secret-manager>
# ASSET_DB_JDBC_URL=<store-in-secret-manager>
# Optional isolated PostgreSQL profile name for integration tests only (never production).
# TEST_DATABASE_PROFILE=

# Optional service defaults
# ASSET_SCHEMA_PREFIX=DWS_
# ASSET_OPERATOR=system

# Runtime behaviour. Invalid or out-of-range values use safe defaults.
# APP_PAGE_SIZE_DEFAULT=20
# APP_PAGE_SIZE_MAX=200
# FIELD_MAPPING_STATS_CACHE_TTL_SECONDS=300
# PORTAL_STATS_CACHE_TTL_SECONDS=600
# APP_SLOW_SERVICE_SECONDS=3
# SEARCH_DEFAULT_LIMIT=5
# SEARCH_MODULE_LIMIT=10
# SEARCH_MAX_LIMIT=50

# Admin seed (手动插入 p_admin_user 时参考，无自动初始化脚本)
# ASSET_ADMIN_USER=admin
# ASSET_ADMIN_PASSWORD=admin123
# ASSET_ADMIN_DISPLAY_NAME=管理员

# Flask runtime
# FLASK_HOST=127.0.0.1
# FLASK_PORT=5099
# Debug is disabled unless this is one of: 1, true, yes, on.
# FLASK_DEBUG=false
# Required in every environment; do not use a fixed or default value.
# FLASK_SECRET_KEY=<generate-a-strong-random-value>
# Defaults to production. Set development explicitly only for local HTTP development.
# FLASK_ENV=development
# Optional comma-separated cross-origin allowlist. Leave unset for same-origin deployment.
# FLASK_CORS_ORIGINS=http://localhost:5173
# Request body ceiling in MiB (1..512, default 16); oversized bodies -> HTTP 413.
# FLASK_MAX_CONTENT_LENGTH_MB=16
# Trust X-Forwarded-For from a reverse proxy for audit-log client IPs.
# Keep false unless requests only ever arrive through a trusted proxy (e.g. Nginx).
# ASSET_TRUST_PROXY_HEADERS=false
# AUTH_SESSION_DAYS=14

# Logging
# APP_LOG_LEVEL=INFO
# APP_LOG_MAX_BYTES=2097152
# APP_LOG_BACKUP_COUNT=5
