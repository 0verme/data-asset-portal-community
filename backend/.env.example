# 首次部署模板：只填写 Core 配置。Advanced/Test 配置见 docs/configuration.md。

# Application
APP_ENV=production
APP_SECRET_KEY=<generate-a-strong-random-value>
APP_DEBUG=false
# APP_CORS_ORIGINS=https://portal.example.com
APP_LOG_LEVEL=INFO

# Database profile and config
# Copy backend/configs/database.example.yaml → backend/configs/database.yaml (not committed).
# Leave ASSET_DB_CONFIG_PATH unset to use that default path (resolved from the backend package,
# independent of process cwd). Set an absolute path only for environment-specific YAML.
ASSET_DB_PROFILE=primary
# ASSET_AUTH_DB_PROFILE=primary
# ASSET_DB_CONFIG_PATH=/absolute/path/to/database.yaml
# Optional non-empty overrides; secrets should come from a secret manager.
# ASSET_DB_PASSWORD=
# ASSET_DB_DSN=

# Deployment/security policy
ASSET_TRUST_PROXY_HEADERS=false
AUTH_SESSION_DAYS=14

# Compatibility note:
# APP_* names are preferred. Existing FLASK_* names remain supported as a
# fallback for migration; APP_* wins when both names are set. See
# docs/configuration.md for the compatibility period and advanced settings.
